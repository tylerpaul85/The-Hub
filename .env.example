# ============================================================
# MSREG Hub — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is listed in .gitignore.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Publishable (anon) key — safe to expose to browser
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# SECURITY CRITICAL: Service role key — bypasses RLS entirely.
# NEVER expose to browser or client. Rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXX
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXX

# ── External API Keys ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXX
FUB_API_KEY=XXXXXXXXXXXX
FUB_SYSTEM_KEY=XXXXXXXXXXXX

# ── Access Control ────────────────────────────────────────────
# REQUIRED — app returns 500 if unset. Use a strong random string.
# Do NOT use the old default "MSREG2026".
TOOLBOX_ACCESS_CODE=GENERATE_A_STRONG_RANDOM_CODE_HERE

# REQUIRED — scorecard cron hook rejects all requests if unset.
# Generate with: openssl rand -hex 32
CRON_HOOK_SECRET=GENERATE_WITH_openssl_rand_hex_32

# ── Webhooks ──────────────────────────────────────────────────
# REQUIRED — InstantDecoAI webhook HMAC secret.
# Configure InstantDecoAI to sign webhook payloads with this secret.
# Generate with: openssl rand -hex 32
INSTANTDECO_WEBHOOK_SECRET=GENERATE_WITH_openssl_rand_hex_32
